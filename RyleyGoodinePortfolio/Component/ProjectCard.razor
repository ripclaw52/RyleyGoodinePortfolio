<a href="@($"/projects/{@Slug}")" style="text-decoration: none; color: inherit;">
<article class="project-card">
    
    @if (!string.IsNullOrEmpty(ThumbnailUrl))
    {
        <img src="@ThumbnailUrl"
             alt="@Title"
             class="project-image" />
    }

    <h2>@Title</h2>

    <p>@((MarkupString)Summary)</p>

    @if (Technologies?.Any() == true)
    {
        <TechPills TechList="Technologies" />
    }

    <NavLink href="@($"/projects/{@Slug}")" class="details-link">
        View Details ->
    </NavLink>

</article>
</a>

<!-- STYLE -->
<style>
    .project-card {
        background: white;
        padding: 2rem;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }

    .project-image {
        width: 100%;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    .tech-stack {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
        margin: 1rem 0;
    }

        .tech-stack span {
            background: #e5e7eb;
            padding: .4rem .8rem;
            border-radius: 999px;
        }

    .details-link {
        display: flex;
        gap: 1rem;
    }
</style>

<!-- CODE -->
@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string ThumbnailUrl { get; set; } = "";
    [Parameter] public string Summary { get; set; } = "";
    [Parameter] public List<string> Technologies { get; set; } = new();
}