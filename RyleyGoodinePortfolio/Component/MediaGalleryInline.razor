@using RyleyGoodinePortfolio.Models

@if (MediaItems?.Any() == true)
{
    <div class="inline-media-grid @(GetGridClass())">

        @foreach (var (media, index) in MediaItems.Select((m, i) => (m, i)))
        {
            <div class="inline-media-item"
                 @onclick="() => OpenMedia(index)">

                @if (media.Type == MediaType.Image)
                {
                    <div class="media-preview">
                        <img src="@media.Url"
                             alt="@media.Caption" />
                    </div>
                }
                else if (media.Type == MediaType.Video)
                {
                    var parsed = VideoHelper.Parse(media.Url);

                    <div class="thumbnail-wrapper">

                        @if (!string.IsNullOrEmpty(parsed.thumbnailUrl))
                        {
                            <img src="@parsed.thumbnailUrl"
                                 alt="@media.Caption" />
                        }

                        <div class="play-overlay"></div>

                    </div>
                }
                <div class="media-caption">
                    @media.Caption
                </div>

            </div>
        }

    </div>

    <MediaGalleryModal @ref="Gallery"
                       MediaItems="MediaItems" />
}

<style>
    .media-preview {
        aspect-ratio: 16 / 10;
        /*overflow: hidden;
        position: relative;*/
    }

    .media-caption {
        padding: .75rem 1rem;
        font-size: .9rem;
        line-height: 1.4;
        color: var(--text);
        background: var(--surface);
        border-top: 1px solid var(--border);
        min-height: 70px;
        display: flex;
        align-items: center;
    }

    .inline-media-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 1.5rem;
        margin: 2rem 0;
    }

    .inline-media-item {
        cursor: pointer;
        overflow: hidden;
        border-radius: 12px;
        background: #f3f4f6;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s ease;
        grid-column: span 4;
    }

        .inline-media-item:hover {
            transform: translateY(-3px);
        }

        .inline-media-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .inline-media-grid.two-items .inline-media-item {
        grid-column: span 6;
    }

    .inline-media-grid.one-item .inline-media-item {
        grid-column: span 12;
    }

    /* Video thumbnail wrapper */
    .thumbnail-wrapper {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
    }

        .thumbnail-wrapper img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Play overlay */
    .play-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,0.35);
    }

        .play-overlay::before {
            content: '▶';
            font-size: 3rem;
            color: white;
        }
</style>

@code {

    [Parameter]
    public List<ProjectMedia> MediaItems { get; set; } = new();

    private MediaGalleryModal? Gallery;

    private async Task OpenMedia(int index)
    {
        if (Gallery is not null)
        {
            await Gallery.Open(index);
        }
    }

    private string GetGridClass()
    {
        return MediaItems.Count switch
        {
            1 => "one-item",
            2 => "two-items",
            _ => ""
        };
    }
}