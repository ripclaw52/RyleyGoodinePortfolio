@using RyleyGoodinePortfolio.Models

@if (MediaItems?.Any() == true)
{
    <div class="inline-media-grid">

        @foreach (var (media, index) in MediaItems.Select((m, i) => (m, i)))
        {
            <div class="inline-media-item"
                 @onclick="() => OpenMedia(index)">

                @if (media.Type == MediaType.Image)
                {
                    <img src="@media.Url"
                         alt="@media.Caption" />
                }
                else if (media.Type == MediaType.Video)
                {
                    var parsed = VideoHelper.Parse(media.Url);

                    <div class="thumbnail-wrapper">

                        @if (!string.IsNullOrEmpty(parsed.thumbnailUrl))
                        {
                            <img src="@parsed.thumbnailUrl"
                                 alt="@media.Caption" />
                        }

                        <div class="play-overlay"></div>

                    </div>
                }

            </div>
        }

    </div>

    <MediaGalleryModal @ref="Gallery"
                       MediaItems="MediaItems" />
}

<style>
    .inline-media-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
        margin: 2rem 0;
    }

    .inline-media-item {
        cursor: pointer;
        overflow: hidden;
        border-radius: 12px;
        background: #f3f4f6;
        transition: transform 0.2s ease;
    }

        .inline-media-item:hover {
            transform: translateY(-3px);
        }

        .inline-media-item img {
            width: 100%;
            display: block;
            object-fit: cover;
        }

    /* Video thumbnail wrapper */
    .thumbnail-wrapper {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
    }

        .thumbnail-wrapper img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Play overlay */
    .play-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,0.35);
    }

        .play-overlay::before {
            content: '▶';
            font-size: 3rem;
            color: white;
        }
</style>

@code {

    [Parameter]
    public List<ProjectMedia> MediaItems { get; set; } = new();

    private MediaGalleryModal? Gallery;

    private async Task OpenMedia(int index)
    {
        if (Gallery is not null)
        {
            await Gallery.Open(index);
        }
    }
}