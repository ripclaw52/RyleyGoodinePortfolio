@using RyleyGoodinePortfolio.Component
@using RyleyGoodinePortfolio.Models;
@using RyleyGoodinePortfolio.Data;
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components

@page "/projects/{Slug}"

<div class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <NavLink href="/">
                    Home
                </NavLink>
            </li>

            <li class="breadcrumb-item">
                <NavLink href="/projects">
                    Projects
                </NavLink>
            </li>

            <li class="breadcrumb-item active"
                aria-current="page">
                @(Project is null ? "Nothing" : Project.Title)
            </li>
        </ol>
    </nav>
</div>

<PageTitle>@Project?.Title</PageTitle>

<!-- breadcrumb navigation -->

@if (Project is null)
{
    <p>Project not found.</p>
}
else
{
    <div class="container projects-page">

        <div class="col-xl title-group">
            <h1>@((MarkupString)Project.Title)</h1>
        </div>


        <div class="col-xl overview-group">
            <!--
            Should be a short paragraph describing the project
            @Project.Summary is 1-2 sentences of the description.
            -->
            <p>
                @((MarkupString)Project.Description)
            </p>
        </div>


        <!-- Tech Stack -->
        <div class="col-xl tech-group">
            @if (Project.Technologies != null && Project.Technologies.Any())
            {
                <h2>Technologies Used</h2>
                <TechPills TechList="Project.Technologies" ShowCapitalize="true" />
                <p><br /></p>
            }
        </div>


        <!-- GitHub Link -->
        <div class="col-xl github-link">
            @if (Project?.GitHubUrl != null)
            {
                <NavLink href="@Project?.GitHubUrl">
                    <svg height="32" aria-hidden="true" viewBox="0 0 16 16" version="1.1" width="32" data-view-component="true">
                        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
                    </svg> View on GitHub ->
                </NavLink>
                <p><br /></p>
            }
        </div>

        <!-- The meat of the project -->
        <div class="col-xl content-group">
            @if (Project.ProjectBlocks != null && Project.ProjectBlocks.Any())
            {
                @foreach (var block in Project.ProjectBlocks)
                {
                    switch (block.Type)
                    {
                        case BlockType.Html:
                            @((MarkupString)block.Content)
                            break;

                        case BlockType.Image:
                            <figure class="case-study-media">
                                <img src="@block.Url" alt="@block.Caption" />
                                @if (!string.IsNullOrWhiteSpace(block.Caption))
                                {
                                    <figcaption>@block.Caption</figcaption>
                                }
                            </figure>
                            break;

                        case BlockType.Video:
                            <div class="case-study-media">
                                <VideoThumbnailModal
                                    VideoUrl="@block.Url"
                                    Title="@block.Caption" />
                            </div>
                            break;
                            
                        case BlockType.Gallery:
                            <MediaGalleryInline MediaItems="block.MediaItems" />
                            break;
                    }
                }
            }
        </div>


        <!-- 3 column rows for cards -->
        <div class="col-xl media-group">
            @if (Project.Media != null && Project.Media.Any())
            {
                <h2>Media</h2>
                <div class="row media-grid">

                @foreach (var (media, index) in Project.Media.Select((m, i) => (m, i)))
                {
                    <MediaProjectCard Media="media"
                                      MediaList="Project.Media"
                                      Index="index" />
                }
            
                </div>
            }
        </div>

    </div>
}

<!-- CODE -->
@code {

    [Parameter]
    public string Slug { get; set; } = "";

    Project? Project;

    protected override void OnParametersSet()
    {
        Project = ProjectRepository
            .GetAll()
            .FirstOrDefault(p => p.Slug == Slug);
    }

    private RenderFragment RenderElement(Details i) => builder =>
    {
        builder.OpenElement(0, i.E); // dynamic tag name
        builder.AddContent(1, (MarkupString)i.C);
        builder.CloseElement();
    };

}