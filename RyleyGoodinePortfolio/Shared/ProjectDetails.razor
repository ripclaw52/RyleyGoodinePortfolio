@using RyleyGoodinePortfolio.Component
@using RyleyGoodinePortfolio.Models;
@using RyleyGoodinePortfolio.Data;
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components

@page "/projects/{Slug}"

<PageTitle>@Project?.Title</PageTitle>

<!-- breadcrumb navigation -->

@if (Project is null)
{
    <p>Project not found.</p>
}
else
{
    <div class="container projects-page">

        <div class="col-xl title-group">
            <h1>@Project.Title</h1>
        </div>

        <div class="col-xl overview-group">
            <h3>Overview</h3>
            <!--
            Should be a short paragraph describing the project
            @Project.Summary is 1-2 sentences of the description.
            -->
            <p>
                @Project.Description
            </p>
        </div>

        <div class="tech-group">
            <h3>Tech Stack</h3>

            <TechPills TechList="Project.Technologies" />
        </div>

        <!-- The meat of the project -->
        <div class="content-group">
            @if (Project.ProjectContent != null && Project.ProjectContent.Any())
            {
                @foreach (var i in Project.ProjectContent)
                {
                    @RenderElement(i)
                }
            }
        </div>

        <!--
        <div>
            <h3>Challenges</h3>

            <p>
                Describe architecture problems,
                bugs solved, tradeoffs made.
            </p>
        </div>


        <div>
            <h3>Results</h3>

            <p>
                What was built, what worked,
                what you learned.
            </p>
        </div>
        -->

        <!-- 3 column rows for cards -->
        <div class="media-group">
            @if (Project.Media != null && Project.Media.Any())
            {
                <h2>Media</h2>
                <div class="row media-grid">

                @foreach (var (media, index) in Project.Media.Select((m, i) => (m, i)))
                {
                    <MediaProjectCard Media="media"
                                      MediaList="Project.Media"
                                      Index="index" />
                }
            
                </div>
            }
        </div>

    </div>
}


<style>
    .media-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .projects-page {
        display: grid;
        min-height: 100vh;
        margin: auto;
        padding: 4rem 2rem;
    }
</style>

@code {

    [Parameter]
    public string Slug { get; set; } = "";

    Project? Project;

    protected override void OnParametersSet()
    {
        Project = ProjectRepository
            .GetAll()
            .FirstOrDefault(p => p.Slug == Slug);
    }

    private RenderFragment RenderElement(Details i) => builder =>
    {
        builder.OpenElement(0, i.E); // dynamic tag name
        builder.AddContent(1, i.C);
        builder.CloseElement();
    };

}